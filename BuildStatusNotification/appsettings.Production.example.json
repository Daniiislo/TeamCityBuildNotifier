{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.SignalR": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Notifier": {
    "TeamTokenSha256": "REPLACE_WITH_ACTUAL_TEAM_TOKEN_SHA256_HASH",
    "WebhookSecretSha256": "REPLACE_WITH_ACTUAL_WEBHOOK_SECRET_SHA256_HASH",
    "TeamCityBaseUrl": "https://teamcity.example",
    "BufferCapacity": 200,
    "BufferTtlMinutes": 60,
    "ReplayLimit": 50
  }
}
